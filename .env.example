# Only needed by maintainers running `npm run setup:airtable`, the full
# field-level schema reconcile. Operators never need this file: the
# blog-system-install skill provisions the base through the Airtable connector.
#
# Copy to .env.local (gitignored) and fill in.

# Airtable personal access token with schema.bases:write on the target base
AIRTABLE_TOKEN=

# The base to reconcile, e.g. appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=

# Comma separated optional SEO fields this base was installed with.
# Valid values: featured-image,categories,cta
# Internal Links and Sources are always created, they are not optional.
OPTIONAL_SEO_FIELDS=featured-image,cta
